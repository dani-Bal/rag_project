# Application settings
RAG_PROJECT_APP_NAME=rag-project
RAG_PROJECT_DEBUG=false
RAG_PROJECT_VECTOR_LENGTH=384
RAG_PROJECT_LLM_PROVIDER_URL=https://chat-ai.academiccloud.de/v1
RAG_PROJECT_LLM_API_KEY=yoru-api-key
RAG_PROJECT_LLM_MODEL_NAME=qwen3.8-27b
RAG_PROJECT_EMBEDDING_MODEL_NAME=text-embedding-3-small

# OpenAI-compatible provider settings. For local Ollama, see
# docker-compose.ollama.yml and set these to its OpenAI-compatible endpoint.
# OPENAI_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_project
DB_USER=postgres
DB_PASSWORD=rag_password

# Database Configuration
DATABASE_URL=postgresql://postgres:rag_password@postgres:5432/rag_project

# LLM API Keys
LLM_API_KEY=your_LLM_API_KEY_here
# Application Settings
PYTHONPATH=/app
LOG_LEVEL=INFO

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Ollama settings
OLLAMA_PORT=7869
OLLAMA_KEEP_ALIVE=24h
OLLAMA_HOST=0.0.0.0
OLLAMA_BASE_URLS=http://host.docker.internal:7869

# WebUI settings
WEBUI_PORT=8080
WEBUI_ENV=dev
WEBUI_AUTH=False
WEBUI_NAME="valiantlynx AI"
WEBUI_URL=http://localhost:8080
USE_OLLAMA_DOCKER=true

# Frontend
BACKEND_URL=http://backend:8000
