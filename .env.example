# Application settings
RAG_PROJECT_APP_NAME=rag-project
RAG_PROJECT_DEBUG=false

# Add provider credentials here when integrations are implemented.
# OPENAI_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_project
DB_USER=postgres
DB_PASSWORD=

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Database Configuration
DATABASE_URL=postgresql://rag_user:rag_password@postgres:5432/rag_db

# LLM API Keys
LLM_API_KEY=your_LLM_API_KEY_here
# Application Settings
PYTHONPATH=/app
LOG_LEVEL=INFO

# RAG Configuration
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-3.5-turbo
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Ollama settings
OLLAMA_PORT=7869
OLLAMA_KEEP_ALIVE=24h
OLLAMA_HOST=0.0.0.0
OLLAMA_BASE_URLS=http://host.docker.internal:7869

# WebUI settings
WEBUI_PORT=8080
WEBUI_ENV=dev
WEBUI_AUTH=False
WEBUI_NAME=valiantlynx AI
WEBUI_URL=http://localhost:8080
WEBUI_SECRET_KEY=t0p-s3cr3t

# Frontend
BACKEND_URL=http://backend:8000
